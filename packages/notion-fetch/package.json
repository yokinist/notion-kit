{
  "name": "@yokinist/notion-fetch",
  "version": "0.1.2",
  "description": "Rate-limit-safe Notion API helpers: block trees, database rows, and fresh URLs for uploaded files",
  "license": "MIT",
  "author": "yokinist",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yokinist/notion-kit.git",
    "directory": "packages/notion-fetch"
  },
  "keywords": [
    "notion",
    "notion-api",
    "rate-limit",
    "signed-url"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@notionhq/client": "^5.0.0"
  },
  "devDependencies": {
    "@notionhq/client": "^5.27.0",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "homepage": "https://notion-kit-docs.vercel.app/docs/notion-fetch",
  "bugs": {
    "url": "https://github.com/yokinist/notion-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
