{
  "name": "@yokinist/notion-rsc",
  "version": "0.0.0",
  "description": "Render Notion blocks with React Server Components, with no client JavaScript",
  "license": "MIT",
  "author": "yokinist",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yokinist/notion-rsc.git"
  },
  "keywords": [
    "notion",
    "notion-api",
    "react",
    "react-server-components",
    "renderer"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "peerDependencies": {
    "@notionhq/client": ">=5",
    "katex": ">=0.16",
    "react": ">=19",
    "react-tweet": ">=3",
    "shiki": ">=1"
  },
  "peerDependenciesMeta": {
    "katex": {
      "optional": true
    },
    "react-tweet": {
      "optional": true
    },
    "shiki": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@notionhq/client": "^5.27.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.1",
    "katex": "^0.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-tweet": "^3.3.1",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "shiki": "^4.5.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
