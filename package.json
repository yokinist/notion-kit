{
  "name": "notion-kit",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "docs",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w packages -w docs",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "postinstall": "npm run build -w packages"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
